@model IEnumerable<ClientHub.Models.ViewModels.ClientListItemViewModel>

@{
    ViewData["Title"] = "Clients";
}

<h1>Clients</h1>

<p>
    <a class="btn btn-primary"
       asp-controller="Clients"
       asp-action="Create">Create New</a>
</p>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Postal Code</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var client in Model)
        {
            <tr>
                <td>@client.FullName</td>
                <td>@client.Email</td>
                <td>@client.Phone</td>
                <td>@client.PostalCode</td>
                <td>
                    <a class="btn btn-sm btn-outline-primary"
                       asp-controller="Clients"
                       asp-action="Details"
                       asp-route-id="@client.Id">Details</a>
                </td>
            </tr>
        }
    </tbody>
</table>
