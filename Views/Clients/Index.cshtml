@model IEnumerable<ClientHub.Models.ViewModels.ClientListItemViewModel>

@{
    ViewData["Title"] = "Clients";
}

<h1>Clients</h1>

<p>
    <a class="btn btn-primary"
       asp-controller="Clients"
       asp-action="Create">Create New</a>
</p>

<form method="get" asp-controller="Clients" asp-action="Index">
    <div class="input-group mb-3 w-50">
        <input type="text" name="search" value="@ViewData["Search"]" class="form-control"
               placeholder="Search by name or email..." />
        <button type="submit" class="btn btn-outline-secondary">Search</button>
    </div>
</form>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Postal Code</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var client in Model)
        {
            <tr>
                <td>@client.FullName</td>
                <td>@client.Email</td>
                <td>@client.Phone</td>
                <td>@client.PostalCode</td>
                <td>
                    <a class="btn btn-sm btn-outline-primary"
                       asp-controller="Clients"
                       asp-action="Details"
                       asp-route-id="@client.Id">Details</a>
                    <a class="btn btn-sm btn-outline-secondary"
                       asp-controller="Clients"
                       asp-action="Edit"
                       asp-route-id="@client.Id">Edit</a>
                    <a class="btn btn-sm btn-outline-danger"
                       asp-controller="Clients"
                       asp-action="Delete"
                       asp-route-id="@client.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
