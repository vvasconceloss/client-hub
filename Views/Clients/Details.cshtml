@model ClientHub.Models.ViewModels.ClientDetailsViewModel

@{
    ViewData["Title"] = "Client Details";
}

<h1>Client Details</h1>

<dl class="row">
    <dt class="col-sm-3">Name</dt>
    <dd class="col-sm-9">@Model.FullName</dd>

    <dt class="col-sm-3">Email</dt>
    <dd class="col-sm-9">@Model.Email</dd>

    <dt class="col-sm-3">Phone</dt>
    <dd class="col-sm-9">@Model.Phone</dd>

    @if (!string.IsNullOrEmpty(Model.Address))
    {
        <dt class="col-sm-3">Address</dt>
        <dd class="col-sm-9">@Model.Address</dd>
    }

    <dt class="col-sm-3">Postal Code</dt>
    <dd class="col-sm-9">@Model.PostalCode - @Model.City</dd>

    <dt class="col-sm-3">Created At</dt>
    <dd class="col-sm-9">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</dd>
</dl>

<div>
    <a class="btn btn-secondary"
       asp-controller="Clients"
       asp-action="Edit"
       asp-route-id="@Model.Id">Edit</a>
    <a class="btn btn-secondary"
       asp-controller="Clients"
       asp-action="Index">Back to List</a>
</div>
