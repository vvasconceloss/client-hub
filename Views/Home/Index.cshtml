@model ClientHub.Models.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<h1>Dashboard</h1>

<div class="row">
    <div class="col-md-4">
        <div class="card text-center mb-3">
            <div class="card-body">
                <h5 class="card-title">Total Clients</h5>
                <p class="card-text display-6">@Model.TotalClients</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-center mb-3">
            <div class="card-body">
                <h5 class="card-title">Clients This Month</h5>
                <p class="card-text display-6">@Model.ClientsThisMonth</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-center mb-3">
            <div class="card-body">
                <h5 class="card-title">My Clients</h5>
                <p class="card-text display-6">@Model.MyClients</p>
            </div>
        </div>
    </div>
</div>

<h2>Recently Added</h2>

@if (Model.RecentClients.Count == 0)
{
    <p class="text-muted">No clients added yet.</p>
}
else
{
    <ul class="list-group">
        @foreach (var client in Model.RecentClients)
        {
            <li class="list-group-item d-flex justify-content-between align-items-center">
                <a asp-controller="Clients"
                   asp-action="Details"
                   asp-route-id="@client.Id">@client.FullName</a>
                <span class="text-muted">@client.Email</span>
            </li>
        }
    </ul>
}